<h2>Character Bazaar</h2>

{% for message in errors %}
  <div class="error_box">{{ message }}</div>
{% endfor %}
{% for message in success %}
  <div class="success_box">{{ message }}</div>
{% endfor %}

{% if logged %}
  <p>Your transferable Tibia Coins: <strong>{{ viewer_balance|number_format }}</strong></p>
{% else %}
  <p><a href="{{ getLink('account/manage') }}?redirect={{ getLink('character-bazaar')|urlencode }}">Log in</a> to place a bid.</p>
{% endif %}

{% if selected_auction %}
  <table width="100%" cellpadding="4" cellspacing="1">
    <tr bgcolor="{{ config.vdarkborder }}"><td class="white" colspan="2"><b>{{ selected_auction.player_name|e }} — Auction #{{ selected_auction.id }}</b></td></tr>
    <tr bgcolor="{{ getStyle(1) }}"><td>Level / Vocation</td><td>{{ selected_auction.snapshot_level }} / {{ selected_auction.vocation_name }}</td></tr>
    <tr bgcolor="{{ getStyle(2) }}"><td>Current bid</td><td>{{ selected_auction.display_bid|number_format }} transferable Tibia Coins</td></tr>
    <tr bgcolor="{{ getStyle(1) }}"><td>Ends</td><td>{{ selected_auction.ends_at_text }}</td></tr>
    <tr bgcolor="{{ getStyle(2) }}"><td>Description</td><td>{{ selected_auction.description|e }}</td></tr>
  </table>

  {% if selected_auction.is_active %}
    <form method="post" action="{{ getLink('character-bazaar') }}?auction={{ selected_auction.id }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken() }}" />
      <input type="hidden" name="auction_id" value="{{ selected_auction.id }}" />
      <p>
        <label for="bid_amount">Your bid</label>
        <input id="bid_amount" name="bid_amount" type="number" min="{{ selected_auction.display_bid + 1 }}" max="4294967295" required />
        <input type="submit" name="place_bid" value="Place bid" {% if not logged or selected_auction.seller_account_id == viewer_account_id %}disabled{% endif %} />
      </p>
      {% if logged and selected_auction.seller_account_id == viewer_account_id %}<p>You cannot bid on your own character.</p>{% endif %}
    </form>
  {% endif %}

  <h3>Bid history</h3>
  <table width="100%" cellpadding="4" cellspacing="1">
    <tr bgcolor="{{ config.vdarkborder }}"><td class="white"><b>Amount</b></td><td class="white"><b>Placed at</b></td></tr>
    {% for bid in bid_history %}
      <tr bgcolor="{{ getStyle(loop.index) }}"><td>{{ bid.bid_amount|number_format }} coins</td><td>{{ bid.created_at|date('Y-m-d H:i') }}</td></tr>
    {% else %}
      <tr bgcolor="{{ getStyle(1) }}"><td colspan="2">No bids yet.</td></tr>
    {% endfor %}
  </table>
  <p><a href="{{ getLink('character-bazaar') }}">Back to all auctions</a></p>
{% endif %}

<h3>Active auctions</h3>
<table width="100%" cellpadding="4" cellspacing="1">
  <tr bgcolor="{{ config.vdarkborder }}"><td class="white"><b>Character</b></td><td class="white"><b>Level</b></td><td class="white"><b>Vocation</b></td><td class="white"><b>Current bid</b></td><td class="white"><b>Ends</b></td><td></td></tr>
  {% for auction in active_auctions %}
    <tr bgcolor="{{ getStyle(loop.index) }}">
      <td>{{ auction.player_name|e }}</td><td>{{ auction.snapshot_level }}</td><td>{{ auction.vocation_name }}</td>
      <td>{{ auction.display_bid|number_format }} coins{% if auction.has_bidder %}<br/><small>Bid placed</small>{% endif %}</td>
      <td>{{ auction.ends_at_text }}</td><td><a href="{{ getLink('character-bazaar') }}?auction={{ auction.id }}">View / bid</a></td>
    </tr>
  {% else %}
    <tr bgcolor="{{ getStyle(1) }}"><td colspan="6">There are no active character auctions.</td></tr>
  {% endfor %}
</table>

<h3>Finished auctions</h3>
<table width="100%" cellpadding="4" cellspacing="1">
  <tr bgcolor="{{ config.vdarkborder }}"><td class="white"><b>Character</b></td><td class="white"><b>Level</b></td><td class="white"><b>Final bid</b></td><td class="white"><b>Status</b></td><td class="white"><b>Finished</b></td></tr>
  {% for auction in finished_auctions %}
    <tr bgcolor="{{ getStyle(loop.index) }}"><td>{{ auction.player_name|e }}</td><td>{{ auction.snapshot_level }}</td><td>{{ auction.display_bid|number_format }} coins</td><td>{{ auction.status_label }}</td><td>{{ auction.finished_at_text }}</td></tr>
  {% else %}
    <tr bgcolor="{{ getStyle(1) }}"><td colspan="5">No finished auctions yet.</td></tr>
  {% endfor %}
</table>
